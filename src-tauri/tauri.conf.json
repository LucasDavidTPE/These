{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thèse",
  "version": "0.2.0",
  "identifier": "fr.lucasdavid.these",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thèse",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.crossref.org",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Lucas David",
    "shortDescription": "Application de bureau de la thèse",
    "longDescription": "Figures, dépouillement 2S2P1D, campagnes d'essais, bibliographie et planning, partagés entre deux PC par OneDrive.",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "resources": {
      "resources/models/*": "resources/models/",
      "resources/onnxruntime/*": "resources/onnxruntime/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxOEQ1OUM2M0FGMTFBQTMKUldTakd2RTZ4bG1ONGFaR0hjaVZxQ1NlcHdkYm5EOHptZmVlYjFVM0pucGkvK2FCdzY2UjJsaDkK",
      "endpoints": [
        "https://github.com/LucasDavidTPE/These-versions/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
