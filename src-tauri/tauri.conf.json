{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thèse",
  "version": "0.1.0",
  "identifier": "fr.lucasdavid.these",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thèse",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Lucas David",
    "shortDescription": "Application de bureau de la thèse",
    "longDescription": "Figures, dépouillement 2S2P1D, campagnes d'essais, bibliographie et planning, partagés entre deux PC par OneDrive.",
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
